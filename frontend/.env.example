# ============================================================
# Wardrobe-AI - frontend configuration TEMPLATE
#
# Copy to "frontend/.env" only if you need to change the backend
# address. Without this file the app uses http://localhost:5001, which
# is what both developers run day to day.
#
# Note: Create React App reads this at BUILD time, so stop and restart
# `npm start` after changing it. Nothing secret belongs in here -
# anything with the REACT_APP_ prefix is bundled into the JavaScript
# that ships to the browser and is visible to anyone using the app.
# ============================================================

REACT_APP_API_URL=http://localhost:5001

# ============================================================
# Wardrobe-AI - backend configuration TEMPLATE
#
# Copy this file to ".env" in the same folder and fill in the real
# values. ".env" is listed in .gitignore and must NEVER be committed:
# it holds the database password and the image-storage secret, and
# anyone who has them can read or delete every user's data.
#
#     macOS / Linux:  cp .env.example .env
#     Windows:        copy .env.example .env
#
# Both computers working on this project use their OWN .env file, but
# both files must contain the SAME values - that is what makes the two
# machines share one set of accounts, wardrobes and images.
# ============================================================


# ---- REQUIRED: shared database ------------------------------
# The connection string from MongoDB Atlas
# (Atlas -> Connect -> Drivers -> Python). Replace <password> with the
# database user's real password. Keep the "?retryWrites=true&w=majority"
# part that Atlas gives you.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# The database inside that cluster. Both computers MUST use the same
# name or they will end up with separate data again.
MONGODB_DB_NAME=ai_wardrobe


# ---- REQUIRED: login token signing --------------------------
# Any long random string - it signs login tokens. Both computers must
# use the SAME value, otherwise a token issued by one backend is
# rejected by the other. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string


# ---- OPTIONAL but needed for shared images ------------------
# From your Cloudinary dashboard. Without all three, wardrobe photos
# are saved to this computer's disk only and will NOT appear on the
# other computer (the app still runs and says so at startup).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ---- OPTIONAL: weather-aware recommendations ----------------
# Free key from https://openweathermap.org/appid - a new key can take
# up to two hours to activate. Without it, recommendations and trips
# still work, just without weather.
OPENWEATHER_API_KEY=

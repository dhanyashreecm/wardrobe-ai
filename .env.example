# ============================================================
# Wardrobe-AI - backend configuration TEMPLATE
#
# Copy this file to ".env" in the same folder and fill in the real
# values. ".env" is listed in .gitignore and must NEVER be committed:
# it holds the database password and the image-storage secret, and
# anyone who has them can read or delete every user's data.
#
#     macOS / Linux:  cp .env.example .env
#     Windows:        copy .env.example .env
#
# Both computers working on this project use their OWN .env file, but
# both files must contain the SAME values - that is what makes the two
# machines share one set of accounts, wardrobes and images.
# ============================================================


# ---- REQUIRED: shared database ------------------------------
# The connection string from MongoDB Atlas
# (Atlas -> Connect -> Drivers -> Python). Replace <password> with the
# database user's real password. Keep the "?retryWrites=true&w=majority"
# part that Atlas gives you.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# The database inside that cluster. Both computers MUST use the same
# name or they will end up with separate data again.
MONGODB_DB_NAME=ai_wardrobe


# ---- REQUIRED: login token signing --------------------------
# Any long random string - it signs login tokens. Both computers must
# use the SAME value, otherwise a token issued by one backend is
# rejected by the other. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string


# ---- OPTIONAL but needed for shared images ------------------
# From your Cloudinary dashboard. Without all three, wardrobe photos
# are saved to this computer's disk only and will NOT appear on the
# other computer (the app still runs and says so at startup).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ---- OPTIONAL: weather-aware recommendations ----------------
# Free key from https://openweathermap.org/appid - a new key can take
# up to two hours to activate. Without it, recommendations and trips
# still work, just without weather.
OPENWEATHER_API_KEY=


# ---- OPTIONAL: welcome and sign-in emails -------------------
# When these are set, a new account gets a "Welcome to Wardrobe AI"
# message, and each successful login gets a "Welcome back" notice
# that doubles as a security alert.
#
# Leave them blank and the app behaves exactly as before - accounts,
# wardrobes and recommendations all work, they just send no mail.
#
# FOR A GMAIL ADDRESS, SMTP_PASSWORD IS NOT YOUR GMAIL PASSWORD.
# Google has refused ordinary passwords over SMTP since 2022. You
# need an App Password:
#   1. The Google account must have 2-Step Verification turned on.
#   2. Google Account -> Security -> 2-Step Verification -> App passwords
#   3. Create one, and use the 16-character code it shows.
# Set it with:  python -m backend.set_secret SMTP_PASSWORD
#
# The App Password can send mail as this account until it is revoked,
# so it belongs in .env (never committed) exactly like the database
# password - and it is never printed, logged, or returned by the API.
SMTP_USERNAME=
SMTP_PASSWORD=

# Defaults suit Gmail; change only for a different provider.
# Port 587 is STARTTLS, port 465 is implicit SSL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=Wardrobe AI

# Set either to false to switch off just that message.
SEND_WELCOME_EMAIL=true
SEND_LOGIN_EMAIL=true


# ---- OPTIONAL: virtual try-on -------------------------------
# Puts your own clothes onto your own photo using FASHN VTON v1.5
# (Apache-2.0 - unlike IDM-VTON, CatVTON and OOTDiffusion, which are
# CC BY-NC-SA and forbid commercial use).
#
# The model needs a CUDA GPU, which neither machine on this project
# has. The backend calls FASHN's own free public Space on Hugging Face
# ZeroGPU instead - no payment, no credits:
#
#   TRYON_SPACE_ID=fashn-ai/fashn-vton-1.5
#
# (Your own copy from spaces/tryon/, or a Colab share link, also work.)
#
# HUGGINGFACE_API_TOKEN is OPTIONAL. Without it the Space is called
# anonymously, which gets the smallest free ZeroGPU allowance (about
# 2 GPU-minutes a day, low queue priority). A READ token from a free
# Hugging Face account raises that to that account's free allowance
# (about 5 GPU-minutes a day). Neither is unlimited; when it runs out
# the Try-On page says so and every other feature keeps working.
#
# Leave TRYON_SPACE_ID blank and the Try-On page says the feature is
# not configured yet.
#
#   python -m backend.set_secret TRYON_SPACE_ID
#   python -m backend.set_secret HUGGINGFACE_API_TOKEN   (optional)
TRYON_SPACE_ID=
HUGGINGFACE_API_TOKEN=

# "flat-lay" (garment photographed on its own - what the wardrobe
# stores) or "model" (garment photographed being worn).
TRYON_GARMENT_PHOTO_TYPE=flat-lay

# Providers, in priority order. The first one that is configured and
# not cooling down is used; if it fails for a SERVICE reason (quota used
# up, rate limited, GPU queue full, asleep, unreachable, timed out,
# credentials rejected) the same garment goes to the next one. Bad input
# (unsupported garment, unusable photo) never fails over. Each provider
# is tried at most once per garment - no retry loops, no fake images.
#
#   fashn_space  - the Space in TRYON_SPACE_ID (free ZeroGPU allowance:
#                  ~2 GPU-min/day anonymous, ~5 with a free account's
#                  token; resets 24 h after first use; it is per ACCOUNT
#                  across all ZeroGPU Spaces, so another Space does not
#                  add allowance)
#   self_hosted  - the SAME model running in YOUR OWN free notebook
#                  (spaces/tryon/colab_tryon.ipynb on Google Colab or
#                  Kaggle). Put the https share link it prints in
#                  TRYON_FALLBACK_URL. Free GPU when Colab has one; the
#                  link changes every run and the runtime stops when idle.
#
# Leave TRYON_PROVIDERS blank to use TRYON_PROVIDER alone (plus
# self_hosted automatically when TRYON_FALLBACK_URL is set).
TRYON_PROVIDERS=fashn_space,self_hosted
TRYON_FALLBACK_URL=
TRYON_PROVIDER=fashn_space
TRYON_TIMEOUT_SECONDS=300
TRYON_MAX_UPLOAD_MB=8
